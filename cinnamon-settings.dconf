[/]
alttab-switcher-delay=100
command-history=['r']
desktop-effects-close='traditional'
desktop-effects-map='move'
desktop-effects-minimize='fade'
enabled-applets=['panel1:left:0:menu@cinnamon.org:0', 'panel1:left:1:separator@cinnamon.org:1', 'panel1:left:2:grouped-window-list@cinnamon.org:2', 'panel1:right:2:systray@cinnamon.org:3', 'panel1:right:3:notifications@cinnamon.org:5', 'panel1:right:4:printers@cinnamon.org:6', 'panel1:right:6:network@cinnamon.org:10', 'panel1:right:7:sound@cinnamon.org:11', 'panel1:right:8:power@cinnamon.org:12', 'panel1:right:9:calendar@cinnamon.org:13', 'panel1:right:10:cornerbar@cinnamon.org:14', 'panel1:right:0:pomodoro@gregfreeman.org:16', 'panel1:right:5:xapp-status@cinnamon.org:19']
enabled-extensions=@as []
next-applet-id=20
panel-edit-mode=false
panel-zone-symbolic-icon-sizes='[{"panelId": 1, "left": 28, "center": 28, "right": 16}]'
panels-height=['1:40']
window-effect-speed=0

[desktop/background]
picture-uri='file:///home/lauty/mountfujibackround.jpg'

[desktop/input-sources]
sources=[('xkb', 'latam')]

[desktop/interface]
cursor-blink-time=1200
cursor-theme='Bibata-Modern-Classic'
gtk-theme='Orchis-Grey-Dark'
icon-theme='Mint-Y-Yaru'
toolkit-accessibility=false

[desktop/keybindings]
custom-list=['custom3', 'custom2', '__dummy__', 'custom0', 'custom1']

[desktop/keybindings/custom-keybindings/custom0]
binding=['<Primary><Alt>t']
command='kitty'
name='Kitty'

[desktop/keybindings/custom-keybindings/custom1]
binding=['Print']
command='flameshot gui'
name='Flameshot'

[desktop/keybindings/custom-keybindings/custom2]
binding=['<Primary><Alt>g']
command='kitty -e agy'
name='Google Antigravity CLI'

[desktop/keybindings/custom-keybindings/custom3]
binding=['<Primary><Shift>Escape']
command='kitty -e btop'
name='btop++'

[desktop/keybindings/media-keys]
screenshot=@as []
terminal=@as []

[desktop/peripherals/keyboard]
delay=uint32 500
numlock-state=true
repeat-interval=uint32 30

[desktop/screensaver]
default-message='Esperando... Zzz...'
font-time='Ubuntu Medium 64'
layout-group=0
time-format='%H:%M:%S'
use-custom-format=true

[desktop/sound]
event-sounds=false

[desktop/wm/preferences]
auto-raise=false
focus-mode='mouse'
min-window-opacity=30

[gestures]
swipe-down-2='PUSH_TILE_DOWN::end'
swipe-down-3='TOGGLE_OVERVIEW::end'
swipe-down-4='VOLUME_DOWN::end'
swipe-left-2='PUSH_TILE_LEFT::end'
swipe-left-3='WORKSPACE_NEXT::end'
swipe-left-4='WINDOW_WORKSPACE_PREVIOUS::end'
swipe-right-2='PUSH_TILE_RIGHT::end'
swipe-right-3='WORKSPACE_PREVIOUS::end'
swipe-right-4='WINDOW_WORKSPACE_NEXT::end'
swipe-up-2='PUSH_TILE_UP::end'
swipe-up-3='TOGGLE_EXPO::end'
swipe-up-4='VOLUME_UP::end'
tap-3='MEDIA_PLAY_PAUSE::end'

[muffin]
bring-windows-to-current-workspace=true
draggable-border-width=10

[settings-daemon/peripherals/keyboard]
numlock-state='on'

[settings-daemon/plugins/color]
night-light-last-coordinates=(-24.783332999999999, -65.416667000000004)

[settings-daemon/plugins/power]
button-power='interactive'
idle-brightness=10
inhibit-lid-switch=false
lid-close-ac-action='suspend'
lid-close-battery-action='suspend'
sleep-display-ac=600
sleep-display-battery=600
sleep-inactive-ac-timeout=900
sleep-inactive-battery-timeout=900

[settings-daemon/plugins/xsettings]
buttons-have-icons=true
menus-have-icons=true

[theme]
name='WhiteSur-Dark-solid-grey'
